# ============================================================
# DNYFTECH — DNYF-DEV Git Security
# ============================================================

# Cryptographic private material
**/private-key*
**/*private-key*
**/private_key*
**/*private_key*
**/*.pem
**/*.key
**/*.p12
**/*.pfx

# Secure identity/runtime credentials
opt/dnyf/runtime/secure/
opt/dnyf/state/
etc/dnyf/session/
etc/dnyf/pairing/

# Authentication/session state
**/identity.json
**/*token*
**/*secret*
**/*credential*
**/*credentials*
**/*password*

# Local caches
**/peer-cache/
**/cache/

# Runtime-generated state
**/logs/
**/*.log

# Backups — keep these local
backups/

# Termux/local environment
.env
.env.*
!.env.example

# Node
node_modules/

# Python
__pycache__/
*.py[cod]

# Temporary files
*.tmp
*.swp
*.bak
.DS_Store

# OS/runtime generated files
*.pid
*.sock
