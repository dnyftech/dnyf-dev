#!/usr/bin/env node
'use strict';

const fs = require('fs');
const crypto = require('crypto');

const ROOT = process.env.DNYF_ROOT || `${process.env.HOME}/DNYF-DEV`;
const LIB = `${ROOT}/opt/dnyf/runtime/capability/dnyf-capability-negotiation.js`;
const api = require(LIB);

function usage() {
  console.log(`
DNYFTECH CAPABILITY NEGOTIATION

Usage:
  dnyf-capability status
  dnyf-capability offer
  dnyf-capability fingerprint
  dnyf-capability negotiate <offer.json>
  dnyf-capability cache <offer.json>
  dnyf-capability cached <device-id>

Security:
  Capability negotiation does NOT grant trust.
  Capability negotiation does NOT grant authorization.
  Remote execution/install/shell remain disabled.
`);
}

function printJson(value) {
  process.stdout.write(JSON.stringify(value, null, 2) + '\n');
}

const command = process.argv[2];

try {
  if (!command || command === 'help' || command === '--help') {
    usage();
    process.exit(0);
  }

  if (command === 'status') {
    printJson(api.status());
    process.exit(0);
  }

  if (command === 'offer') {
    printJson(api.buildOffer());
    process.exit(0);
  }

  if (command === 'fingerprint') {
    const offer = api.buildOffer();
    console.log(offer.capability_fingerprint);
    process.exit(0);
  }

  if (command === 'negotiate') {
    const file = process.argv[3];

    if (!file) {
      console.error('Missing remote capability offer JSON.');
      process.exit(2);
    }

    const remote = JSON.parse(
      fs.readFileSync(file, 'utf8')
    );

    const local = api.buildOffer();

    printJson(api.negotiate(local, remote));
    process.exit(0);
  }

  if (command === 'cache') {
    const file = process.argv[3];

    if (!file) {
      console.error('Missing capability offer JSON.');
      process.exit(2);
    }

    const offer = JSON.parse(
      fs.readFileSync(file, 'utf8')
    );

    console.log(api.cachePeerOffer(offer));
    process.exit(0);
  }

  if (command === 'cached') {
    const deviceId = process.argv[3];

    if (!deviceId) {
      console.error('Missing device ID.');
      process.exit(2);
    }

    printJson(api.loadCachedPeer(deviceId));
    process.exit(0);
  }

  console.error(`Unknown command: ${command}`);
  usage();
  process.exit(2);

} catch (error) {
  console.error(`[DNYF CAPABILITY ERROR] ${error.message}`);
  process.exit(1);
}
