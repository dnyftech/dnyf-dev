echo "◆ Schema validation..."

node - "$SCHEMA_DIR/dnyf-capability-negotiation-schema.json" <<'NODE'
const fs=require('fs');
const p=process.argv[2];
const x=JSON.parse(fs.readFileSync(p,'utf8'));

if(x.schema!=='dnyf.capability.negotiation.v1') throw new Error('bad schema');
if(x.protocol!=='dnyf-capability/1') throw new Error('bad protocol');
if(x.security.capability_exchange_grants_trust!==false) throw new Error('trust bypass');
if(x.security.capability_exchange_grants_authorization!==false) throw new Error('authorization bypass');
if(x.execution.remote_execution!==false) throw new Error('remote execution enabled');
if(x.execution.remote_installation!==false) throw new Error('remote installation enabled');
if(x.execution.remote_shell!==false) throw new Error('remote shell enabled');
console.log('schema contract valid');
