RESULT_FILE="$STATE/synthetic-negotiation-result.json"

DNYF_ROOT="$ROOT" node - "$OFFER_FILE" "$REMOTE_FILE" "$RESULT_FILE" <<'NODE'
const fs=require('fs');
const api=require(`${process.env.DNYF_ROOT}/opt/dnyf/runtime/capability/dnyf-capability-negotiation.js`);

const local=JSON.parse(fs.readFileSync(process.argv[2],'utf8'));
const remote=JSON.parse(fs.readFileSync(process.argv[3],'utf8'));

const result=api.negotiate(local,remote);

fs.writeFileSync(
  process.argv[4],
  JSON.stringify(result,null,2)+'\n',
  {mode:0o600}
);

if(!result.compatible) {
  throw new Error(
    `synthetic negotiation failed: ${result.reasons.join(',')}`
  );
}

if(result.security.capability_exchange_grants_trust!==false) {
  throw new Error('capability negotiation granted trust');
}

if(result.security.capability_exchange_grants_authorization!==false) {
  throw new Error('capability negotiation granted authorization');
}

if(result.security.remote_execution!==false) {
  throw new Error('remote execution enabled');
}

console.log(JSON.stringify({
  compatible: result.compatible,
  protocol_version: result.negotiated.protocol_version,
  api_version: result.negotiated.api_version,
  transport: result.negotiated.transport,
  architecture_compatible: result.negotiated.architecture_compatible,
  execution_classes: result.negotiated.execution_classes,
  grants_trust: result.security.capability_exchange_grants_trust,
  grants_authorization: result.security.capability_exchange_grants_authorization
},null,2));
NODE

ok "compatible capability negotiation"

