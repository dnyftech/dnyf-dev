const fs=require('fs');
const api=require(`${process.env.DNYF_ROOT}/opt/dnyf/runtime/capability/dnyf-capability-negotiation.js`);

const offer=JSON.parse(fs.readFileSync(process.argv[2],'utf8'));

const a=api.fingerprintOffer(offer);
const b=api.fingerprintOffer(offer);

if(a!==b) throw new Error('non-deterministic fingerprint');
if(a!==offer.capability_fingerprint) throw new Error('fingerprint mismatch');

console.log(a);
NODE

