echo "◆ Verifying capability/trust separation..."

node - "$REGISTRY_FILE" "$STATE/local-capability-state.json" <<'NODE'
const fs=require('fs');

const registry=JSON.parse(fs.readFileSync(process.argv[2],'utf8'));
const state=JSON.parse(fs.readFileSync(process.argv[3],'utf8'));

if(state.capability_exchange_grants_trust!==false) {
  throw new Error('capability exchange trust bypass');
}

if(state.capability_exchange_grants_authorization!==false) {
  throw new Error('capability exchange authorization bypass');
}

if(state.remote_execution!==false) {
  throw new Error('remote execution enabled');
}

if(state.remote_installation!==false) {
  throw new Error('remote installation enabled');
}

if(state.remote_shell!==false) {
  throw new Error('remote shell enabled');
}

const text=JSON.stringify(registry);

if(text.includes('"trusted":true') &&
   state.capability_exchange_grants_trust===true) {
  throw new Error('capability/trust boundary violation');
}

console.log('security separation valid');
NODE

ok "capability/trust security separation"

echo "◆ Verifying canonical identity binding..."

node - "$OFFER_FILE" "$IDENTITY" <<'NODE'
const fs=require('fs');

const offer=JSON.parse(fs.readFileSync(process.argv[2],'utf8'));
const identity=JSON.parse(fs.readFileSync(process.argv[3],'utf8'));

if(
  offer.identity.device_id.toLowerCase() !==
  String(identity.device_id).toLowerCase()
) {
  throw new Error('device ID mismatch');
}

if(
  offer.identity.fingerprint.toLowerCase() !==
  String(identity.fingerprint).toLowerCase()
) {
  throw new Error('fingerprint mismatch');
}

console.log('canonical identity binding valid');
NODE

