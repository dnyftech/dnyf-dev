DNYF_ROOT="$ROOT" node - "$OFFER_FILE" <<'NODE'
const fs=require('fs');
const api=require(`${process.env.DNYF_ROOT}/opt/dnyf/runtime/capability/dnyf-capability-negotiation.js`);

const offer=JSON.parse(fs.readFileSync(process.argv[2],'utf8'));

const before=fs.readdirSync(api.PATHS.cache);

api.cachePeerOffer(offer);

const after=fs.readdirSync(api.PATHS.cache);

if(after.length<=before.length && !after.includes(`${offer.identity.device_id}.json`)) {
  throw new Error('capability cache not written');
}

const cached=api.loadCachedPeer(offer.identity.device_id);

if(!cached || !cached.offer) {
  throw new Error('cached offer unavailable');
}

console.log('cache record valid');
NODE

